    "additionalProperties": true,
    "type": "object",
    "title": "AccessOut"
   },
   "ActionOut": {
    "properties": {
     "key": {
      "type": "string",
      "title": "Key"
     },
     "text": {
      "type": "string",
      "title": "Text"
     },
     "note": {
      "type": "string",
      "title": "Note"
     },
     "cell": {
      "anyOf": [
       {
        "additionalProperties": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "title": "Cell"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "key",
     "text",
     "note"
    ],
    "title": "ActionOut"
   },
   "AltItem": {
    "properties": {
     "sel": {
      "type": "string",
      "title": "Sel"
     },
     "name": {
      "type": "string",
      "title": "Name"
     },
     "distance_km": {
      "type": "number",
      "title": "Distance Km"
     },
     "score": {
      "type": "number",
      "title": "Score"
     },
     "level_class": {
      "type": "string",
      "enum": [
       "suitable",
       "limited",
       "low"
      ],
      "title": "Level Class"
     },
     "level_label": {
      "type": "string",
      "title": "Level Label"
     },
     "dynamics_class": {
      "type": "string",
      "enum": [
       "growth",
       "decline",
       "unreliable",
       "insufficient"
      ],
      "title": "Dynamics Class"
     },
     "dynamics_label": {
      "type": "string",
      "title": "Dynamics Label"
     },
     "centroid": {
      "$ref": "#/components/schemas/LatLon"
     },
     "pasture_km2": {
      "type": "number",
      "title": "Pasture Km2"
     },
     "reasons": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Reasons"
     }
    },
    "additionalProperties": true,
    "type": "object",
    "required": [
     "sel",
     "name",
     "distance_km",
     "score",
     "level_class",
     "level_label",
     "dynamics_class",
     "dynamics_label",
     "centroid",
     "pasture_km2",
     "reasons"
    ],
    "title": "AltItem"
   },
   "AlternativesOut": {
    "properties": {
     "radius_km": {
      "type": "number",
      "title": "Radius Km"
     },
     "items": {
