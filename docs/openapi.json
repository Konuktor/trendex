     {
      "name": "sel",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "examples": [
        "district:at-bashy",
        "block:52202566",
        "point:41.42,75.98,5"
       ],
       "title": "Sel"
      }
     },
     {
      "name": "weights",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Weights"
      }
     },
     {
      "name": "season",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "summer",
       "title": "Season"
      }
     },
     {
      "name": "lang",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "pattern": "^(en|ru)$",
       "default": "en",
       "title": "Lang"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Card"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
